{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@pi-meme/client/*": ["../../../packages/client/src/*"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
